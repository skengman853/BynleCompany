generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum DocumentStatus {
  PENDING
  INDEXED
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

enum BillingPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum JobType {
  INGEST_DOCUMENT
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ChatRequestStatus {
  SUCCESS
  ERROR
  RATE_LIMITED
  EMERGENCY
  BLOCKED
}

enum BookingStatus {
  CONFIRMED
  CANCELED
}

model Tenant {
  id                String      @id @default(cuid())
  name              String
  status            String      @default("active")
  plan              BillingPlan @default(STARTER)
  monthlyChatLimit  Int         @default(1000)
  monthlyTokenLimit Int         @default(400000)
  hardLimitEnabled  Boolean     @default(true)
  alertEmail        String?
  createdAt         DateTime    @default(now())

  users         User[]
  settings      Settings?
  faqs          Faq[]
  conversations Conversation[]
  messages      Message[]
  leads         Lead[]
  documents     KbDocument[]
  chunks        KbChunk[]
  jobs          Job[]
  apiKeys       TenantApiKey[]
  auditLogs     AuditLog[]
  usageDaily    TenantUsageDaily[]
  chatTelemetry ChatTelemetry[]
  bookings      Booking[]
}

model TenantApiKey {
  id        String   @id @default(cuid())
  tenantId  String
  keyHash   String   @unique
  last4     String
  label     String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model User {
  id            String    @id @default(cuid())
  tenantId      String
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(OWNER)
  createdAt     DateTime  @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]
}

model Settings {
  tenantId             String   @id
  businessName         String
  phone                String
  address              String
  hours                String
  acceptingNewClients  Boolean  @default(true)
  holidayMessage       String?
  bookingUrl           String?
  calendlyEnabled      Boolean  @default(false)
  calendlyApiToken     String?
  calendlyEventTypeUri String?
  calendlyTimezone     String?
  emergencyMessage     String?
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Faq {
  id        String   @id @default(cuid())
  tenantId  String
  question  String
  answer    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Conversation {
  id        String   @id @default(cuid())
  tenantId  String
  sessionId String
  startedAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  messages Message[]

  @@unique([tenantId, sessionId])
}

model Message {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model Lead {
  id        String     @id @default(cuid())
  tenantId  String
  sessionId String
  name      String
  phone     String?
  email     String?
  message   String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model KbDocument {
  id         String         @id @default(cuid())
  tenantId   String
  filename   String
  storageUrl String
  status     DocumentStatus @default(PENDING)
  lastError  String?
  version    Int            @default(1)
  createdAt  DateTime       @default(now())

  tenant Tenant    @relation(fields: [tenantId], references: [id])
  chunks KbChunk[]
}

model KbChunk {
  id         String   @id @default(cuid())
  tenantId   String
  documentId String
  chunkIndex Int
  chunkText  String
  // Store raw embedding payload for now; switch back to pgvector when extension is installed.
  embedding  Json?
  createdAt  DateTime @default(now())

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  document KbDocument @relation(fields: [documentId], references: [id])

  @@unique([documentId, chunkIndex])
  @@index([tenantId, documentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model TenantUsageDaily {
  id               String   @id @default(cuid())
  tenantId         String
  date             DateTime
  chatCount        Int      @default(0)
  tokenCount       Int      @default(0)
  errorCount       Int      @default(0)
  rateLimitedCount Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date])
}

model ChatTelemetry {
  id               String            @id @default(cuid())
  tenantId         String
  sessionId        String
  conversationId   String?
  status           ChatRequestStatus
  latencyMs        Int
  contextItems     Int               @default(0)
  kbContextItems   Int               @default(0)
  promptTokens     Int               @default(0)
  completionTokens Int               @default(0)
  totalTokens      Int               @default(0)
  model            String?
  errorMessage     String?
  createdAt        DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

model Booking {
  id                   String        @id @default(cuid())
  tenantId             String
  sessionId            String?
  provider             String        @default("CALENDLY")
  providerEventTypeUri String?
  providerEventUri     String?
  providerInviteeUri   String?       @unique
  status               BookingStatus @default(CONFIRMED)
  startTime            DateTime?
  endTime              DateTime?
  timezone             String?
  inviteeName          String?
  inviteeEmail         String?
  inviteePhone         String?
  cancelUrl            String?
  rescheduleUrl        String?
  canceledAt           DateTime?
  cancellationReason   String?
  rawPayload           Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([providerEventUri])
}

model WebhookReceipt {
  id        String   @id @default(cuid())
  provider  String
  signature String
  timestamp Int
  createdAt DateTime @default(now())

  @@unique([provider, signature])
  @@index([provider, createdAt])
}

model Job {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(PENDING)
  tenantId    String
  payload     Json
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([status, runAt, createdAt])
  @@index([tenantId, createdAt])
}

// Auth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
