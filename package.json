{
  "name": "bynle",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:admin-web": "npm run dev -w apps/admin-web",
    "dev:assist-api": "npm run dev -w apps/assist-api",
    "dev:assist-worker": "npm run dev -w apps/assist-worker",
    "dev:admin": "npm run dev:admin-web",
    "dev:api": "npm run dev:assist-api",
    "dev:worker": "npm run dev:assist-worker",
    "lint": "npm run typecheck",
    "typecheck": "npm run typecheck -w apps/assist-api && npm run typecheck -w apps/assist-worker",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "ci": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
