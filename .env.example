# Shared
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bynle

# Auth.js
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDINGS_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
UPLOAD_DIR=./uploads
KB_VECTOR_WEIGHT=0.65
KB_LEXICAL_WEIGHT=0.35
BILLING_PRECHAT_TOKEN_RESERVE=1200
SLO_SUCCESS_RATE_TARGET=0.99
ALERT_P95_MS=3500
ALERT_ERROR_RATE=0.03
ALERT_TOKEN_PER_CHAT=6000

# Worker queue
JOB_POLL_INTERVAL_MS=2000
JOB_RETRY_BASE_MS=5000
JOB_RETRY_MAX_MS=60000
JOB_STALE_LOCK_MS=600000
